[Unit]
Description=Hearthcore Claude Guild Quartermaster (Sonnet 5.5 40-char supply & work orders)
Wants=network-online.target
After=network-online.target
OnFailure=hearthcore-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/hearthcore
ExecStart=/usr/bin/python3 -m hearthcore quartermaster-tick --provider anthropic
TimeoutStartSec=180
NoNewPrivileges=yes
UMask=0077
Nice=15
CPUQuota=20%
MemoryMax=128M
StandardOutput=journal
StandardError=journal
