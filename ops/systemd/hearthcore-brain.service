[Unit]
Description=Hearthcore AI Brain session-boundary planner (Claude AI via .env)
Wants=network-online.target
After=network-online.target
OnFailure=hearthcore-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/hearthcore
ExecStart=/usr/bin/python3 -m hearthcore brain-tick --provider anthropic
TimeoutStartSec=600
NoNewPrivileges=yes
UMask=0077
Nice=15
CPUQuota=20%
MemoryMax=128M
StandardOutput=journal
StandardError=journal
