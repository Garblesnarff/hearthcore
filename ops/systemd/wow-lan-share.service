[Unit]
Description=Temporary LAN WoW 3.3.5a Laptop Setup & Client Streamer (port 8788)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/wonky/wow-lan-share
ExecStart=/usr/bin/python3 /home/wonky/wow-lan-share/serve.py
Nice=15
CPUAffinity=0 1
MemoryMax=128M
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
