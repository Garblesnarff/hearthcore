[Unit]
Description=Azeroth Watch — Lightweight Hearthguard Observability Daemon
Wants=network-online.target
After=network-online.target
OnFailure=hearthcore-failure@%n.service

[Service]
Type=simple
WorkingDirectory=%h/azeroth-watch
# Safe default: bind loopback only (127.0.0.1). To expose on LAN, add a systemd drop-in
# (see ops/systemd/azeroth-watch.service.d/lan-readonly.conf.example) and consider
# AZEROTH_WATCH_REQUIRE_AUTH_FOR_READS=1 (Issue #71).
ExecStart=/usr/bin/taskset -c 0-1 /usr/bin/nice -n 15 /usr/bin/python3 %h/azeroth-watch/server.py --host 127.0.0.1 --port 8787 --interval 4.0
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
UMask=0077
MemoryHigh=80M
MemoryMax=128M

[Install]
WantedBy=default.target
